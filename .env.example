# Client-side (Vite inlines VITE_-prefixed vars into the browser bundle --
# safe here since these are the public anon/publishable key, protected by RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Build-only (read by scripts/fetch-content.mjs before vite-react-ssg builds,
# never imported from src/, never VITE_-prefixed so Vite never inlines it into
# the client bundle). Bypasses RLS -- keep this out of anywhere client-facing.
SUPABASE_SERVICE_ROLE_KEY=
